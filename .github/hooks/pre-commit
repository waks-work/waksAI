#!/bin/bash
echo "🔍 Running pre-commit checks for waksAI..."

[ -f "rust/waks_ai_backend/Cargo.toml" ] && cargo fmt --manifest-path rust/waks_ai_backend/Cargo.toml

if ! command -v luac &> /dev/null; then
    echo "luac not found, skipping Lua syntax check"
else
    find lua -name "*.lua" -exec luac -p {} \;
fi

echo "Pre-commit checks passed!"
